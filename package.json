  "description": "Keep the HONOR Share discoverable switch enabled through Honor WorkStation's local IPC.",
  "main": "keepalive.js",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/lvlucky3641/honor-share-keepalive#readme",
  "repository": {
    "type": "git",
